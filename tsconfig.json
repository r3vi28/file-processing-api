{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "types": ["node", "jest"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "noEmit": true
    },
    "include": [
        "src", "tests"
    ],
    "exclude": [
        "node_modules"
    ]
}
